  "query": "\n                SELECT DISTINCT s.id, s.display_name,\n                       s.description, s.duration_minutes, s.price, e.organization_id\n                FROM services s\n                LEFT JOIN employees e ON s.master_id = e.id\n                WHERE s.master_id = ANY($1) OR s.master_id IS NULL\n                ",
