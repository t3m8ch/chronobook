{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT b.id, b.service_id,\n                       b.master_id, b.branch_id, b.started_at, b.ended_at\n                FROM bookings b\n                INNER JOIN employees e ON b.master_id = e.id\n                WHERE e.organization_id = $1\n                AND b.ended_at > $2\n                AND b.started_at < $3\n                ",
