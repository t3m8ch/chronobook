  "query": "\n                SELECT id, service_id,\n                       master_id, branch_id, started_at, ended_at\n                FROM bookings\n                WHERE master_id = ANY($1)\n                AND branch_id = ANY($2)\n                AND ended_at > $3\n                AND started_at < $4\n                ",
