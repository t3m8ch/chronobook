  "query": "\n            SELECT\n                s.id, s.display_name, s.description,\n                s.duration_minutes, s.price, e.organization_id\n            FROM services s\n            LEFT JOIN employees e ON s.master_id = e.id\n            WHERE s.id = $1\n            ",
